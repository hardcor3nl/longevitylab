---
/** Shared styles for the free-tools hub, API docs and press kit. Theme with the same --lk-* variables as the other panels. */
import LkBase from "./LkBase.astro";
---
<LkBase />
<style is:global>
  .l3 { max-width: 56rem; }
  .l3 h2 { margin: 2.5rem 0 .5rem; font-size: clamp(1.35rem, 1.1rem + .8vw, 1.75rem); font-weight: 700; line-height: 1.25; }
  .l3 h3 { margin: 1.5rem 0 .35rem; font-size: 1.1rem; font-weight: 700; line-height: 1.3; }
  .l3-lead { margin: 0 0 1rem; line-height: 1.6; }
  .l3-card { margin: 1rem 0; padding: 1rem 1.1rem; border-radius: 12px; border: 1px solid var(--lk-line, #d4d4d8); background: var(--lk-bg, transparent); color: var(--lk-ink, inherit); }
  .l3-card > h3 { margin-top: 0; }
  .l3-card p { margin: .35rem 0; line-height: 1.55; }
  .l3-muted { color: var(--lk-muted, inherit); font-size: .9rem; }
  .l3-a { color: var(--lk-accent, currentColor); text-decoration: underline; overflow-wrap: anywhere; }
  .l3-a:focus-visible { outline: 2px solid var(--lk-accent, currentColor); outline-offset: 2px; }
  .l3-list { list-style: none; margin: .5rem 0; padding: 0; display: grid; gap: .4rem; }
  .l3-list li { line-height: 1.5; overflow-wrap: anywhere; }
  .l3-code { box-sizing: border-box; width: 100%; padding: .6rem .7rem; border-radius: 8px; border: 1px solid var(--lk-line, #d4d4d8); background: var(--lk-field, transparent); color: var(--lk-field-ink, inherit); font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; overflow-x: auto; white-space: pre; margin: .5rem 0; }
  .l3-ico { display: block; background: #fff; padding: .5rem; border-radius: 8px; border: 1px solid var(--lk-line, #d4d4d8); }
  .l3-facts { list-style: none; margin: 1rem 0; padding: 0; display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .l3-fact { padding: .9rem 1rem; border-radius: 10px; border: 1px solid var(--lk-line, #d4d4d8); background: var(--lk-bg, transparent); color: var(--lk-ink, inherit); }
  .l3-fact .v { display: block; font-size: 1.6rem; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
  .l3-fact .t { display: block; font-weight: 600; margin: .15rem 0; }
  .l3-fact .m { display: block; font-size: .85rem; color: var(--lk-muted, inherit); line-height: 1.5; }
  .l3 details > summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-weight: 600; color: var(--lk-accent, currentColor); }
  .l3 details > summary:focus-visible { outline: 2px solid var(--lk-accent, currentColor); outline-offset: 2px; }
</style>
