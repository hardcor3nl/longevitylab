---
interface Props { caption?: string; headers: string[]; rows: string[][]; checked?: string; firstColHeader?: boolean }
const { caption, headers, rows, checked, firstColHeader = true } = Astro.props;
---
<div class="table-wrap" tabindex="0" role="region" aria-label={caption ?? "Comparison table"}>
  <table>
    {caption && <caption>{caption}</caption>}
    <thead><tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr></thead>
    <tbody>
      {rows.map((r) => <tr>{r.map((c, i) => (firstColHeader && i === 0 ? <th scope="row" set:html={c} /> : <td set:html={c} />))}</tr>)}
    </tbody>
  </table>
  {checked && <p class="table-checked">Prices and limits checked <time datetime={checked}>{checked}</time>.</p>}
</div>
