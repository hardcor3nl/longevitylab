{
  "name": "thelongevityintel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/build-images.mjs && node scripts/build-search-index.mjs",
    "build": "pnpm check:content && astro build && pnpm seo:gate",
    "preview": "astro preview",
    "check:content": "node --experimental-strip-types ../../packages/schema/src/cli.ts --site ./site.config.json",
    "cf:dev": "wrangler pages dev dist --d1=DB",
    "build:draft": "astro build",
    "seo:gate": "node --experimental-strip-types ../../packages/tooling/src/seo/cli.ts . --only redirects,crawl,linkgraph,duplicates,head,sitemaps,structured-data,og"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource/dm-mono": "^5.2.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@lucide/astro": "^1.48.0",
    "@portfolio/core": "workspace:*",
    "@portfolio/schema": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.143.0"
  }
}
