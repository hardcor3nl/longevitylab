---
import { ArrowUpRight, Clock } from "@lucide/astro";
import Hero from "./Hero.astro";
import { articleUrl, CATEGORY_LABEL, type Article } from "../lib/content";
interface Props { article: Article; size?: "lg" | "md" | "sm" }
const { article: a, size = "md" } = Astro.props;
const d = a.data;
---
<a href={articleUrl(a)} class={`group block h-full rounded-2xl overflow-hidden border border-border bg-surface lift ${size === "lg" ? "md:grid md:grid-cols-2" : "flex flex-col"}`} style="box-shadow:var(--shadow-sm)">
  <div class={`relative overflow-hidden bg-surface-2 ${size === "lg" ? "h-64 md:h-full md:min-h-80" : "h-44"}`}>
    <Hero id={d.image} alt="" sizes={size === "lg" ? "(min-width:768px) 50vw, 100vw" : "(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw"} class="group-hover:scale-[1.04] transition-transform duration-700" />
    <div class="absolute inset-0 bg-linear-to-t from-black/35 to-transparent"></div>
    <div class="absolute top-3 left-3 flex gap-2">
      <span class="font-mono text-[10px] uppercase tracking-widest bg-ink/85 text-cream dark:bg-black/70 dark:text-white backdrop-blur-sm px-2.5 py-1 rounded-full">{CATEGORY_LABEL[a.category]}</span>
      {d.featured && <span class="font-mono text-[10px] uppercase tracking-widest bg-amber-fill text-white px-2.5 py-1 rounded-full" style="background:var(--amber-fill);color:#1a1206">Featured</span>}
    </div>
  </div>
  <div class={`flex flex-col flex-1 ${size === "lg" ? "p-7 justify-center" : "p-5"}`}>
    <h3 class={`font-display text-ink group-hover:text-green transition-colors leading-tight mb-2 ${size === "lg" ? "text-3xl" : "text-xl"}`}>{d.title}</h3>
    <p class={`text-muted text-sm leading-relaxed mb-4 ${size === "lg" ? "line-clamp-3" : "line-clamp-2"}`}>{d.description}</p>
    <div class="mt-auto flex items-center justify-between text-xs text-muted font-mono">
      <span class="flex items-center gap-1.5"><Clock class="w-3 h-3" aria-hidden="true" />{a.minutes} min read</span>
      <span class="flex items-center gap-1 text-green-bright font-sans font-semibold">Read <ArrowUpRight class="w-3 h-3 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true" /></span>
    </div>
  </div>
</a>
